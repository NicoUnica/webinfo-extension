{
  "manifest_version": 3,
  "name": "__MSG_nombreExtension__",
  "short_name": "WebInfo",
  "version": "2.1.0",
  "description": "__MSG_descripcionExtension__",
  "default_locale": "es",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://ipwho.is/*",
    "https://host.tools/*",
    "https://who-dat.as93.net/*",
    "https://cloudflare-dns.com/*",
    "https://tile.openstreetmap.org/*"
  ],
  "action": {
    "default_popup": "codigo/ventana/ventana.html",
    "default_icon": {
      "16": "recursos/iconos/icono16.png",
      "32": "recursos/iconos/icono32.png",
      "48": "recursos/iconos/icono48.png",
      "128": "recursos/iconos/icono128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://ipwho.is https://host.tools https://who-dat.as93.net https://cloudflare-dns.com; img-src 'self' https://tile.openstreetmap.org data:; style-src 'self' 'unsafe-inline'"
  },
  "minimum_chrome_version": "102",
  "icons": {
    "16": "recursos/iconos/icono16.png",
    "32": "recursos/iconos/icono32.png",
    "48": "recursos/iconos/icono48.png",
    "128": "recursos/iconos/icono128.png"
  }
}
